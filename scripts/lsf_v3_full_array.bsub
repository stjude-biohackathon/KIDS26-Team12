#!/bin/bash
#BSUB -J "kids26_v3full[1-30]"
#BSUB -q priority
#BSUB -n 4
#BSUB -R "span[hosts=1] rusage[mem=60GB]"
#BSUB -M 240GB
#BSUB -W 8:00
#BSUB -o logs/v3full_%J_%I.out
#BSUB -e logs/v3full_%J_%I.err
# =============================================================================
# KIDS26 Team 12 - FULL 30-fold V3-abs LOCO run as a 30-task LSF array.
# =============================================================================
#
# WHAT THIS RUNS
#   The same nested leave-one-cancer-out protocol as scripts/lsf_loco_array.bsub
#   (run 01), with ONE architectural change: feature_rank="within_tissue"
#   (V3-abs) instead of the pooled variance filter. The target stays `identity`
#   at fit time, exactly as run 01, so this array isolates the ranking change.
#
#   One task per development cancer type. Each task holds out its own cancer,
#   tunes on cancer-grouped inner folds built only from the remaining types,
#   fits, and predicts the held-out type. Tasks are fully independent - no task
#   reads another task's output, so a single failure is cheap to re-run.
#
# WHY A FULL RUN NOW
#   The 4-fold V3-abs sentinel (results/v3_sentinel) passed all 7 pre-registered
#   gates, which is the pre-agreed authorisation for the full 30 folds. A
#   sentinel cannot produce the macro metrics or the permutation nulls; only the
#   complete fold set can, via scripts/loco_merge.R.
#
# -------------------------------------------------------------------------
# RESOURCE CHOICES - inherited from the measured run-01 template
# -------------------------------------------------------------------------
#   [1-30]      One task per development cancer type. If the cohort ever gains
#               or loses a type this range MUST be updated; loco_merge.R refuses
#               to merge if a fold is missing, which is the safety net.
#
#   *** rusage[mem] ON THIS CLUSTER IS PER SLOT, NOT PER JOB. ***
#   LSF multiplies rusage[mem] by the slot count from -n. The rule is that
#   rusage[mem] x (-n) must fit on ONE node, or every task sits PENDING forever
#   with "Job's requirements for resource reservation not satisfied
#   (Resource: mem)" - which looks like a busy queue but never starts.
#
#   -n 4        Four slots. The work is memory-bound, not CPU-bound: the run-01
#               dry run used 3,360 s of CPU over 3,324 s of wall, so barely more
#               than one core was ever busy.
#
#   rusage[mem=60GB]
#               60 GB x 4 slots = 240 GB reserved per task. The measured peak for
#               a fold was 173 GB (job 323075937), so ~39% headroom.
#
#   -M 240GB    Hard kill limit as the whole-job total, kept equal to
#               rusage[mem] x (-n) so reservation and limit agree.
#
#   NO %N THROTTLE - DELIBERATE, DO NOT ADD ONE
#               scripts/lsf_loco_array.bsub throttles with %4 because it targets
#               the 2-node biohackathon queue. This array runs on `priority`
#               (rhel8_rome: 46 nodes at 1,003 GB plus 14 at 1.9 TB), where 30
#               concurrent 240 GB tasks place across many hosts. We are on the
#               clock and need all 30 folds running at once: throttling to %4
#               would turn a ~1 h wall time into ~8 h of waves. Add a throttle
#               only if the queue is genuinely contended and another team is
#               blocked behind us.
#
#   -W 8:00     A fold is 45-55 min on a quiet node, 65-85 min under load. LSF
#               kills at the wall limit; over-requesting time is cheap, while
#               under-requesting loses the whole task.
#
# SUBMIT
#   bsub < scripts/lsf_v3_full_array.bsub
#
# MONITOR
#   bjobs -A                          # array summary: done / pending / running
#   bjobs -w                          # per-task state and host
#   tail -f logs/v3full_<JOBID>_1.out
#
# AFTER ALL TASKS COMPLETE
#   Rscript scripts/loco_merge.R results/v3_loco_full data/processed/master_samples.tsv
#
#   The merge performs the pooled tissue-mean null, within-tissue permutation and
#   purity-stratified analyses. Those determine whether there is a finding at
#   all, and they cannot be computed per fold.
#
# RERUNNING A FAILED TASK
#       bsub -q priority -n 4 -R "span[hosts=1] rusage[mem=60GB]" -M 240GB -W 8:00 \
#            -o logs/v3full_rerun_%J.out -e logs/v3full_rerun_%J.err \
#            "cd $PWD && Rscript scripts/loco_one_fold.R data/processed/beta.tsv \
#             data/processed/master_samples.tsv results/v3_loco_full <INDEX> \
#             identity within_tissue"
# =============================================================================

set -euo pipefail

REPO=/research/groups/shelagrp/home/esavage/KIDS26/KIDS26-Team12
BETA=data/processed/beta.tsv
META=data/processed/master_samples.tsv
OUT=results/v3_loco_full

cd "$REPO"
mkdir -p logs "$OUT/folds"

echo "=== v3-abs full array job ${LSB_JOBID} task ${LSB_JOBINDEX} on $(hostname) ==="
echo "started: $(date)"
free -g | head -2
echo

# Pin thread counts to the slots LSF granted. Without this, R's BLAS would spawn
# one thread per physical core (up to 128 on some rome nodes), oversubscribing
# our allocation, slowing this job down and disrupting others on the same host.
export OMP_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export OPENBLAS_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}
export MKL_NUM_THREADS=${LSB_DJOB_NUMPROC:-4}

# LSB_JOBINDEX is 1-based and maps directly onto the 1-based fold index, which
# indexes the sorted development cancer types.
# identity      = no target transform (run 01 behaviour, unchanged).
# within_tissue = THE ONE CHANGE that defines V3-abs.
Rscript scripts/loco_one_fold.R "$BETA" "$META" "$OUT" "${LSB_JOBINDEX}" identity within_tissue

echo
echo "finished: $(date)"
